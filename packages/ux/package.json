{
  "name": "@commercelayer/cli-ux",
  "description": "Commerce Layer Javascript CLI ux lib",
  "version": "1.2.1",
  "author": "Pierluigi Viti <pierluigi@commercelayer.io>",
  "license": "MIT",
  "repository": "github:commercelayer/commercelayer-cli-ux",
  "main": "lib/index.js",
  "types": "lib/index.d.ts",
  "module": "lib/index.mjs",
  "exports": {
    "types": "./lib/index.d.ts",
    "require": "./lib/index.js",
    "import": "./lib/index.mjs"
  },
  "scripts": {
    "build": "tsup",
    "start": "tsx src/index.ts",
    "test": "jest --passWithNoTests",
    "test-local": "tsx test/spot.ts",
    "coverage": "jest --coverage",
    "lint": "biome check --enforce-assist=true",
    "check": "biome check --enforce-assist=true --write",
    "release": "pnpm upgrade && pnpm lint && pnpm build"
  },
  "keywords": [
    "ecommerce",
    "commercelayer"
  ],
  "files": [
    "lib/**/*"
  ],
  "engines": {
    "node": ">=20"
  },
  "devDependencies": {
    "@babel/preset-env": "^7.29.7",
    "@babel/preset-typescript": "^7.29.7",
    "@biomejs/biome": "^2.5.6",
    "@oclif/core": "^3.27.0",
    "@semantic-release/changelog": "^6.0.3",
    "@semantic-release/git": "^10.0.1",
    "@types/cli-progress": "^3.11.6",
    "@types/color": "^3.0.7",
    "@types/jest": "^29.5.14",
    "@types/js-yaml": "^3.12.10",
    "@types/node": "^20.19.43",
    "@types/slice-ansi": "^4.0.0",
    "@types/supports-color": "^8.1.3",
    "@types/wordwrap": "^1.0.3",
    "jest": "^29.7.0",
    "oclif": "^4.23.29",
    "semantic-release": "^25.0.8",
    "tsup": "^8.5.1",
    "tsx": "^4.23.1",
    "typescript": "^5.9.3"
  },
  "dependencies": {
    "ansi-escapes": "^4.3.2",
    "ansi-styles": "^4.3.0",
    "cardinal": "^2.1.1",
    "chalk": "^4.1.2",
    "cli-progress": "^3.12.0",
    "color": "^4.2.3",
    "hyperlinker": "^1.0.0",
    "js-yaml": "^3.15.0",
    "natural-orderby": "^2.0.3",
    "object-treeify": "^1.1.33",
    "password-prompt": "^1.1.3",
    "slice-ansi": "^4.0.0",
    "string-width": "^4.2.3",
    "strip-ansi": "^6.0.1",
    "supports-color": "^8.1.1",
    "supports-hyperlinks": "^2.3.0",
    "wordwrap": "^1.0.0"
  },
  "peerDependencies": {
    "@oclif/core": "3.27.0"
  },
  "publishConfig": {
    "access": "public"
  }
}

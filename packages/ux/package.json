{
  "name": "@commercelayer/cli-ux",
  "description": "Commerce Layer Javascript CLI ux lib",
  "version": "1.2.4",
  "author": "Pierluigi Viti <pierluigi@commercelayer.io>",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/commercelayer/commercelayer-cli.git",
    "directory": "packages/ux"
  },
  "main": "lib/index.js",
  "types": "lib/index.d.ts",
  "module": "lib/index.mjs",
  "exports": {
    "types": "./lib/index.d.ts",
    "require": "./lib/index.js",
    "import": "./lib/index.mjs"
  },
  "scripts": {
    "build": "tsup",
    "start": "tsx src/index.ts",
    "test": "jest --passWithNoTests",
    "test-local": "tsx test/spot.ts",
    "coverage": "jest --coverage",
    "lint": "biome check --enforce-assist=true",
    "check": "biome check --enforce-assist=true --write",
    "release": "pnpm upgrade && pnpm lint && pnpm build"
  },
  "keywords": [
    "ecommerce",
    "commercelayer"
  ],
  "files": [
    "lib/**/*"
  ],
  "engines": {
    "node": ">=20"
  },
  "devDependencies": {
    "@babel/preset-env": "catalog:",
    "@babel/preset-typescript": "catalog:",
    "@oclif/core": "catalog:",
    "@types/cli-progress": "catalog:",
    "@types/color": "^3.0.7",
    "@types/jest": "catalog:",
    "@types/js-yaml": "^3.12.10",
    "@types/node": "^20.19.43",
    "@types/slice-ansi": "^4.0.0",
    "@types/supports-color": "^8.1.3",
    "@types/wordwrap": "^1.0.3",
    "jest": "catalog:",
    "oclif": "catalog:",
    "tsup": "catalog:",
    "tsx": "catalog:",
    "typescript": "^5.9.3"
  },
  "dependencies": {
    "ansi-escapes": "^4.3.2",
    "ansi-styles": "^4.3.0",
    "cardinal": "^2.1.1",
    "chalk": "catalog:",
    "cli-progress": "catalog:",
    "color": "^4.2.3",
    "hyperlinker": "^1.0.0",
    "js-yaml": "^3.15.1",
    "natural-orderby": "^2.0.3",
    "object-treeify": "^1.1.33",
    "password-prompt": "^1.1.3",
    "slice-ansi": "^4.0.0",
    "string-width": "^4.2.3",
    "strip-ansi": "^6.0.1",
    "supports-color": "^8.1.1",
    "supports-hyperlinks": "^2.3.0",
    "wordwrap": "^1.0.0"
  },
  "peerDependencies": {
    "@oclif/core": "3.27.0"
  },
  "publishConfig": {
    "access": "public"
  },
  "homepage": "https://github.com/commercelayer/commercelayer-cli/tree/main/packages/ux",
  "bugs": "https://github.com/commercelayer/commercelayer-cli/issues"
}

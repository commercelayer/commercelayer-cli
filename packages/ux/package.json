{
  "name": "@commercelayer/cli-ux",
  "description": "Internal package of the Commerce Layer CLI: terminal IO utilities shared by the CLI and its plugins. Not intended for direct use.",
  "version": "2.0.0-beta.0",
  "author": "Pierluigi Viti <pierluigi@commercelayer.io>",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/commercelayer/commercelayer-cli.git",
    "directory": "packages/ux"
  },
  "main": "lib/index.js",
  "types": "lib/index.d.ts",
  "module": "lib/index.mjs",
  "exports": {
    "types": "./lib/index.d.ts",
    "require": "./lib/index.js",
    "import": "./lib/index.mjs"
  },
  "scripts": {
    "build": "tsup",
    "start": "tsx src/index.ts",
    "test": "nyc --extension .ts mocha --forbid-only \"test/**/*.test.ts\"",
    "test-local": "tsx test/spot.ts"
  },
  "keywords": [
    "ecommerce",
    "commercelayer"
  ],
  "files": [
    "lib/**/*"
  ],
  "engines": {
    "node": ">=22.13"
  },
  "devDependencies": {
    "@commercelayer/cli-test-utils": "workspace:*",
    "@oclif/core": "catalog:",
    "@types/chai": "catalog:",
    "@types/cli-progress": "catalog:",
    "@types/mocha": "catalog:",
    "@types/node": "catalog:",
    "@types/wordwrap": "^1.0.3",
    "chai": "catalog:",
    "mocha": "catalog:",
    "nock": "catalog:",
    "nyc": "catalog:",
    "oclif": "catalog:",
    "tsup": "catalog:",
    "tsx": "catalog:",
    "typescript": "^5.9.3"
  },
  "dependencies": {
    "ansi-escapes": "^7.3.0",
    "ansi-styles": "^7.0.0",
    "cardinal": "^2.1.1",
    "chalk": "catalog:",
    "cli-progress": "catalog:",
    "color": "^5.0.3",
    "hyperlinker": "^1.0.0",
    "js-yaml": "^5.4.2",
    "natural-orderby": "^5.0.0",
    "object-treeify": "^5.0.1",
    "password-prompt": "^1.1.3",
    "slice-ansi": "^9.0.1",
    "string-width": "^8.3.0",
    "strip-ansi": "^7.2.0",
    "supports-color": "^11.0.0",
    "supports-hyperlinks": "^4.5.0",
    "wordwrap": "^1.0.0"
  },
  "peerDependencies": {
    "@oclif/core": "^5.1.2"
  },
  "publishConfig": {
    "access": "public"
  },
  "homepage": "https://github.com/commercelayer/commercelayer-cli/tree/main/packages/ux",
  "bugs": "https://github.com/commercelayer/commercelayer-cli/issues"
}

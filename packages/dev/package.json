{
  "name": "@commercelayer/cli-dev",
  "description": "Commerce Layer CLI development tools and helpers",
  "version": "3.0.7",
  "author": "Pierluigi Viti <pierluigi@commercelayer.io>",
  "homepage": "https://github.com/commercelayer/commercelayer-cli-dev",
  "repository": "commercelayer/commercelayer-cli-dev",
  "bugs": "https://github.com/commercelayer/commercelayer-cli-dev/issues",
  "bin": {
    "cl-cli-dev": "./bin/run.js"
  },
  "engines": {
    "node": ">=20"
  },
  "files": [
    "/bin/run.*",
    "/lib",
    "/npm-shrinkwrap.json",
    "/oclif.manifest.json"
  ],
  "keywords": [
    "ecommerce",
    "cli",
    "commercelayer"
  ],
  "license": "MIT",
  "main": "lib/index.js",
  "oclif": {
    "commands": "./lib/commands",
    "bin": "cl-cli-dev",
    "devPlugins": [
      "@oclif/plugin-help"
    ],
    "plugins": [],
    "repositoryPrefix": "<%- repo %>/blob/main/<%- commandPath %>",
    "additionalHelpFlags": [
      "-h"
    ],
    "topicSeparator": ":"
  },
  "scripts": {
    "pretest": "pnpm build --noEmit && echo 'Skipping test dir compile check in CI for now (3rd party type error) but you should compile it locally'",
    "test": "nyc --extension .ts mocha --forbid-only \"test/**/*.test.ts\"",
    "posttest": "pnpm lint",
    "build": "rm -rf lib && tsc",
    "prepack": "pnpm build && oclif manifest && pnpm readme",
    "postpack": "rm -f oclif.manifest.json",
    "readme": "./bin/run.js readme && git add README.md",
    "lint": "eslint . --ext .ts --config .eslintrc",
    "lintspec": "eslint ./specs/ --ext .spec.ts",
    "lint:fix": "eslint src --fix"
  },
  "types": "lib/index.d.ts",
  "devDependencies": {
    "@commercelayer/eslint-config-ts": "^1.4.5",
    "@oclif/plugin-help": "^5.2.20",
    "@oclif/test": "^2.5.6",
    "@semantic-release/changelog": "^6.0.3",
    "@semantic-release/git": "^10.0.1",
    "@types/chai": "^4.3.20",
    "@types/fs-extra": "^9.0.13",
    "@types/lodash": "^4.17.20",
    "@types/mocha": "^10.0.10",
    "@types/node": "^20.19.11",
    "chai": "^4.5.0",
    "eslint": "^8.57.1",
    "globby": "^10.0.2",
    "mocha": "^10.8.2",
    "nyc": "^15.1.0",
    "oclif": "^4.22.12",
    "semantic-release": "^23.1.1",
    "tsx": "^4.20.4",
    "typescript": "^5.9.2"
  },
  "dependencies": {
    "@oclif/core": "^3.27.0",
    "fs-extra": "^10.1.0",
    "github-slugger": "^1.5.0",
    "lodash": "^4.17.21",
    "normalize-package-data": "^5.0.0",
    "tslib": "^2.8.1"
  },
  "publishConfig": {
    "access": "public"
  }
}

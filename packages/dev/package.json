{
  "name": "@commercelayer/cli-dev",
  "description": "Commerce Layer CLI development tools and helpers",
  "version": "0.1.1",
  "author": "Pierluigi Viti <pierluigi@commercelayer.io>",
  "bugs": "https://github.com/commercelayer/commercelayer-cli-dev/issues",
  "bin": {
    "cl-cli-dev": "./bin/run"
  },
  "devDependencies": {
    "@oclif/plugin-help": "^5.1.11",
    "@oclif/test": "^2.1.0",
    "@types/chai": "^4.3.0",
    "@types/fs-extra": "^9.0.13",
    "@types/lodash": "^4.14.178",
    "@types/mocha": "^5.2.7",
    "@types/node": "^16.11.25",
    "chai": "^4.3.6",
    "eslint": "^5.16.0",
    "eslint-config-oclif": "^3.1.0",
    "eslint-config-oclif-typescript": "^0.2.0",
    "globby": "^10.0.2",
    "lodash": "^4.17.21",
    "mocha": "^5.2.0",
    "nyc": "^14.1.1",
    "ts-node": "^10.5.0",
    "typescript": "^4.5.5"
  },
  "engines": {
    "node": ">=16"
  },
  "files": [
    "/bin",
    "/lib",
    "/npm-shrinkwrap.json",
    "/oclif.manifest.json"
  ],
  "homepage": "https://github.com/commercelayer/commercelayer-cli-dev",
  "keywords": [
    "oclif",
    "ecommerce",
    "cli",
    "commercelayer"
  ],
  "license": "MIT",
  "main": "lib/index.js",
  "oclif": {
    "commands": "./lib/commands",
    "bin": "cl-cli-dev",
    "devPlugins": [
      "@oclif/plugin-help"
    ],
    "plugins": [],
    "repositoryPrefix": "<%- repo %>/blob/main/<%- commandPath %>",
    "additionalHelpFlags": [
      "-h"
    ],
    "topicSeparator": ":"
  },
  "repository": "commercelayer/commercelayer-cli-dev",
  "scripts": {
    "changelog": "conventional-changelog -p angular -i CHANGELOG.md -s -r 0 && git add CHANGELOG.md",
    "lint": "eslint . --ext .ts --config .eslintrc",
    "postpack": "rm -f oclif.manifest.json",
    "posttest": "npx lint",
    "prepack": "npm run build && oclif manifest && npm run version",
    "test": "mocha --forbid-only \"test/**/*.test.ts\"",
    "version": "npm run changelog && oclif readme && git add README.md",
    "pretest": "npm run build --noEmit && echo 'Skipping test dir compile check in CI for now (3rd party type error) but you should compile it locally'",
    "build": "rm -rf lib && tsc"
  },
  "types": "lib/index.d.ts",
  "dependencies": {
    "@oclif/core": "^1.3.4",
    "fs-extra": "^10.0.1",
    "github-slugger": "^1.4.0",
    "normalize-package-data": "^3.0.3",
    "tslib": "^2.3.1"
  },
  "publishConfig": {
    "access": "public"
  }
}

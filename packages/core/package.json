{
  "name": "@commercelayer/cli-core",
  "version": "5.11.4",
  "description": "Commerce Layer Javascript CLI core lib",
  "author": "Pierluigi Viti <pierluigi@commercelayer.io>",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/commercelayer/commercelayer-cli.git",
    "directory": "packages/core"
  },
  "main": "lib/index.js",
  "types": "lib/index.d.ts",
  "module": "lib/index.mjs",
  "exports": {
    "types": "./lib/index.d.ts",
    "require": "./lib/index.js",
    "import": "./lib/index.mjs"
  },
  "scripts": {
    "build": "tsup",
    "start": "tsx src/index.ts",
    "test": "jest --passWithNoTests",
    "test-local": "tsx test/spot.ts",
    "coverage": "jest --coverage"
  },
  "keywords": [
    "ecommerce",
    "commercelayer"
  ],
  "files": [
    "lib/**/*"
  ],
  "engines": {
    "node": ">=20"
  },
  "devDependencies": {
    "@babel/preset-env": "catalog:",
    "@babel/preset-typescript": "catalog:",
    "@types/jest": "catalog:",
    "@types/jsonwebtoken": "^9.0.10",
    "@types/node": "catalog:",
    "dotenv": "catalog:",
    "jest": "catalog:",
    "oclif": "catalog:",
    "tsup": "catalog:",
    "tsx": "catalog:",
    "typescript": "^5.9.3"
  },
  "dependencies": {
    "@commercelayer/js-auth": "^6.7.2",
    "@oclif/core": "catalog:",
    "chalk": "catalog:",
    "jsonwebtoken": "^9.0.3",
    "update-notifier-cjs": "catalog:"
  },
  "publishConfig": {
    "access": "public"
  },
  "homepage": "https://github.com/commercelayer/commercelayer-cli/tree/main/packages/core",
  "bugs": "https://github.com/commercelayer/commercelayer-cli/issues"

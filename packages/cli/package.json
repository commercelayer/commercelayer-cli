{
  "name": "@commercelayer/cli",
  "description": "Commerce Layer CLI",
  "version": "6.9.8",
  "author": "Pierluigi Viti <pierluigi@commercelayer.io>",
  "license": "MIT",
  "homepage": "https://github.com/commercelayer/commercelayer-cli/tree/main/packages/cli",
  "repository": {
    "type": "git",
    "url": "https://github.com/commercelayer/commercelayer-cli.git",
    "directory": "packages/cli"
  },
  "bugs": "https://github.com/commercelayer/commercelayer-cli/issues",
  "bin": {
    "commercelayer": "./bin/run.js",
    "cl": "./bin/run.js",
    "clayer": "./bin/run.js"
  },
  "engines": {
    "node": ">=20"
  },
  "files": [
    "/bin/run.*",
    "/lib",
    "/npm-shrinkwrap.json",
    "/oclif.manifest.json"
  ],
  "keywords": [
    "ecommerce",
    "cli",
    "commercelayer"
  ],
  "main": "lib/index.js",
  "types": "lib/index.d.ts",
  "oclif": {
    "commands": "./lib/commands",
    "bin": "commercelayer",
    "plugins": [
      "@oclif/plugin-help",
      "@oclif/plugin-not-found",
      "@oclif/plugin-plugins",
      "@oclif/plugin-autocomplete"
    ],
    "devPlugins": [],
    "aliases": {
      "blocked": null
    },
    "hooks": {
      "init": [
        "./lib/hooks/init/update"
      ],
      "prerun": [
        "./lib/hooks/prerun/login",
        "./lib/hooks/prerun/plugin",
        "./lib/hooks/prerun/application"
      ],
      "postrun": [
        "./lib/hooks/postrun/save",
        "./lib/hooks/postrun/autocomplete",
        "./lib/hooks/postrun/plugins_update"
      ]
    },
    "topics": {
      "applications": {
        "description": "Manage login to CLI applications"
      },
      "plugins": {
        "description": "Manage CLI plugins"
      },
      "config": {
        "description": "Manage CLI configuration",
        "hidden": true
      },
      "cli": {
        "description": "Core CLI commands",
        "hidden": false
      }
    },
    "helpClass": "./lib/help",
    "repositoryPrefix": "<%- repo %>/blob/main/packages/cli/<%- commandPath %>",
    "additionalHelpFlags": [
      "-h"
    ],
    "additionalVersionFlags": [
      "-v"
    ],
    "topicSeparator": ":"
  },
  "scripts": {
    "build": "rm -rf lib && tsc -b",
    "prepack": "pnpm build && oclif manifest && pnpm readme",
    "postpack": "rm -f oclif.manifest.json",
    "test": "nyc --extension .ts mocha --forbid-only \"test/**/*.test.ts\" --require dotenv/config",
    "readme": "cl-cli-dev readme --multi && git add README.md && git add docs/*"
  },
  "devDependencies": {
    "@commercelayer/cli-dev": "workspace:^",
    "@fig/complete-oclif": "^2.0.1",
    "@oclif/test": "catalog:",
    "@types/chai": "catalog:",
    "@types/configstore": "^4.0.0",
    "@types/inquirer": "catalog:",
    "@types/lodash.kebabcase": "^4.1.9",
    "@types/mocha": "catalog:",
    "@types/node": "catalog:",
    "@types/update-notifier": "^5.1.0",
    "@withfig/autocomplete-types": "^1.31.0",
    "chai": "catalog:",
    "dotenv": "catalog:",
    "mocha": "catalog:",
    "nyc": "catalog:",
    "oclif": "catalog:",
    "prettier": "^3.9.6",
    "tsx": "catalog:",
    "typescript": "catalog:"
  },
  "dependencies": {
    "@commercelayer/cli-core": "workspace:^",
    "@commercelayer/cli-ux": "workspace:^",
    "@commercelayer/provisioning-sdk": "catalog:",
    "@commercelayer/sdk": "catalog:",
    "@oclif/core": "catalog:",
    "@oclif/plugin-autocomplete": "^3.2.56",
    "@oclif/plugin-help": "catalog:",
    "@oclif/plugin-not-found": "^3.2.93",
    "@oclif/plugin-plugins": "^5.4.87",
    "configstore": "^5.0.1",
    "inquirer": "catalog:",
    "lodash.kebabcase": "^4.1.1",
    "tslib": "catalog:",
    "update-notifier-cjs": "catalog:"
  },
  "publishConfig": {
    "access": "public"
  }
}

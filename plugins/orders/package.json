{
  "name": "@commercelayer/cli-plugin-orders",
  "description": "Commerce Layer CLI Orders plugin",
  "version": "5.6.5",
  "author": "Pierluigi Viti <pierluigi@commercelayer.io>",
  "homepage": "https://github.com/commercelayer/commercelayer-cli/tree/main/plugins/orders",
  "repository": {
    "type": "git",
    "url": "https://github.com/commercelayer/commercelayer-cli.git",
    "directory": "plugins/orders"
  },
  "bugs": "https://github.com/commercelayer/commercelayer-cli/issues",
  "engines": {
    "node": ">=20"
  },
  "files": [
    "/bin/run.*",
    "/lib",
    "/npm-shrinkwrap.json",
    "/oclif.manifest.json"
  ],
  "keywords": [
    "ecommerce",
    "cli",
    "commercelayer"
  ],
  "license": "MIT",
  "main": "lib/index.js",
  "oclif": {
    "commands": "./lib/commands",
    "bin": "cl-orders",
    "devPlugins": [
      "@oclif/plugin-help"
    ],
    "plugins": [],
    "topics": {
      "orders": {
        "description": "Execute actions on orders",
        "hidden": false
      }
    },
    "repositoryPrefix": "<%- repo %>/blob/main/plugins/orders/<%- commandPath %>",
    "additionalHelpFlags": [
      "-h"
    ],
    "topicSeparator": ":"
  },
  "scripts": {
    "build": "rm -rf lib && tsc -b",
    "prepack": "pnpm build && oclif manifest && pnpm readme",
    "postpack": "rm -f oclif.manifest.json",
    "test": "nyc --extension .ts mocha --forbid-only \"test/**/*.test.ts\"",
    "posttest": "pnpm lint",
    "readme": "cl-cli-dev readme --plugin --bin=commercelayer && git add README.md",
    "lint": "biome check --enforce-assist=true",
    "check": "biome check --enforce-assist=true --write",
    "release": "pnpm upgrade && pnpm lint && pnpm prepack && pnpm postpack",
    "generate": "cl-generate",
    "generate-local": "cl-generate --local"
  },
  "types": "lib/index.d.ts",
  "devDependencies": {
    "@commercelayer/cli-dev": "workspace:^",
    "@commercelayer/cli-generator": "workspace:*",
    "@oclif/plugin-help": "^6.2.58",
    "@oclif/test": "^3.2.15",
    "@types/chai": "^4.3.20",
    "@types/inquirer": "^8.2.13",
    "@types/mocha": "^10.0.10",
    "@types/node": "^25.9.5",
    "chai": "^4.5.0",
    "mocha": "^11.8.0",
    "nyc": "^15.1.0",
    "oclif": "^4.23.30",
    "tsx": "^4.23.12",
    "typescript": "^6.0.3"
  },
  "dependencies": {
    "@commercelayer/cli-core": "workspace:^",
    "@commercelayer/cli-ux": "workspace:^",
    "@commercelayer/sdk": "^6.58.0",
    "@oclif/core": "^3.27.0",
    "inquirer": "^8.2.7",
    "tslib": "^2.8.1"
  },
  "publishConfig": {
    "access": "public"
  }
}

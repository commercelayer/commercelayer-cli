{
  "name": "@commercelayer/cli-plugin-resources",
  "description": "Commerce Layer CLI Resources plugin",
  "version": "6.18.5",
  "author": "Pierluigi Viti <pierluigi@commercelayer.io>",
  "homepage": "https://github.com/commercelayer/commercelayer-cli/tree/main/plugins/resources",
  "repository": {
    "type": "git",
    "url": "https://github.com/commercelayer/commercelayer-cli.git",
    "directory": "plugins/resources"
  },
  "bugs": "https://github.com/commercelayer/commercelayer-cli/issues",
  "engines": {
    "node": ">=20.18.1"
  },
  "files": [
    "/bin/run.*",
    "/lib",
    "/npm-shrinkwrap.json",
    "/oclif.manifest.json"
  ],
  "keywords": [
    "ecommerce",
    "cli",
    "commercelayer"
  ],
  "license": "MIT",
  "main": "lib/index.js",
  "oclif": {
    "commands": "./lib/commands",
    "bin": "cl-resources",
    "devPlugins": [
      "@oclif/plugin-help"
    ],
    "plugins": [],
    "topics": {
      "resources": {
        "description": "Execute CRUD operations on API resources"
      },
      "order": {
        "description": "Execute special operations on orders",
        "hidden": true
      }
    },
    "repositoryPrefix": "<%- repo %>/blob/main/plugins/resources/<%- commandPath %>",
    "additionalHelpFlags": [
      "-h"
    ],
    "topicSeparator": ":"
  },
  "scripts": {
    "build": "rm -rf lib && tsc -b",
    "prepack": "pnpm resources && pnpm build && oclif manifest && pnpm readme",
    "postpack": "rm -f oclif.manifest.json",
    "test": "nyc --extension .ts mocha --forbid-only \"test/**/*.test.ts\"",
    "posttest": "pnpm lint",
    "readme": "cl-cli-dev readme --plugin --bin=commercelayer && git add README.md",
    "generate": "cl-generate",
    "lint": "biome check --enforce-assist=true",
    "check": "biome check --enforce-assist=true --write",
    "release": "pnpm upgrade && pnpm generate && pnpm lint && pnpm prepack && pnpm postpack",
    "generate-local": "cl-generate --local"
  },
  "types": "lib/index.d.ts",
  "devDependencies": {
    "@commercelayer/cli-dev": "workspace:^",
    "@commercelayer/cli-generator": "workspace:*",
    "@oclif/plugin-help": "catalog:",
    "@oclif/test": "catalog:",
    "@types/chai": "catalog:",
    "@types/inquirer": "catalog:",
    "@types/mocha": "catalog:",
    "@types/node": "catalog:",
    "@types/node-notifier": "catalog:",
    "chai": "catalog:",
    "mocha": "catalog:",
    "nyc": "catalog:",
    "oclif": "catalog:",
    "tsx": "catalog:",
    "typescript": "catalog:"
  },
  "dependencies": {
    "@commercelayer/cli-core": "workspace:^",
    "@commercelayer/cli-ux": "workspace:^",
    "@commercelayer/sdk": "catalog:",
    "@oclif/core": "catalog:",
    "inquirer": "catalog:",
    "json-2-csv": "catalog:",
    "node-notifier": "catalog:",
    "open": "catalog:",
    "tslib": "catalog:"
  },
  "publishConfig": {
    "access": "public"
  }
}
